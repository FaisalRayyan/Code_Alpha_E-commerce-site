{% load static %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="ShopSphere premium joggers e-commerce store."
    >

    <title>
        {% block title %}
            ShopSphere
        {% endblock %}
    </title>

    <!-- Main website styles -->
    <link
        rel="stylesheet"
        href="{% static 'css/style.css' %}"
    >

    <!-- Page-specific styles -->
    {% block extra_css %}
    {% endblock %}

    <!-- Global header styles must load last -->
    <link
        rel="stylesheet"
        href="{% static 'css/global.css' %}"
    >
    <link
       rel="stylesheet"
       href="{% static 'css/password-toggle.css' %}"
    >
</head>

<body>
    {% if messages %}
        <div class="site-messages">
            {% for message in messages %}
                <div
                    class="site-message site-message--{{ message.tags }}"
                    role="alert"
                >
                    {{ message }}
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <header class="site-header">
        <a
            href="{% url 'core:home' %}"
            class="site-header__brand"
        >
            ShopSphere
        </a>

        <nav
            class="site-header__navigation"
            aria-label="Main navigation"
        >
            <a href="{% url 'core:home' %}">
                Home
            </a>

            <a href="{% url 'products:product_list' %}">
                Shop
            </a>

            <a
                href="{% url 'cart:cart_detail' %}"
                class="site-header__cart"
            >
                Cart

                <span>
                    {{ global_cart_count }}
                </span>
            </a>

            {% if request.user.is_authenticated %}
                <a href="{% url 'accounts:profile' %}">
                    Profile
                </a>

                <span class="site-header__customer">
                    Hi,
                    {{ request.user.first_name|default:request.user.username }}
                </span>

                <form
                    method="post"
                    action="{% url 'accounts:logout' %}"
                    class="site-header__logout-form"
                >
                    {% csrf_token %}

                    <button
                        type="submit"
                        class="site-header__logout-button"
                    >
                        Logout
                    </button>
                </form>
            {% else %}
                <a href="{% url 'accounts:login' %}">
                    Login
                </a>

                <a
                    href="{% url 'accounts:register' %}"
                    class="site-header__register"
                >
                    Register
                </a>
            {% endif %}
        </nav>
    </header>

    <main>
        {% block content %}
        {% endblock %}
    </main>

    <script src="{% static 'js/app.js' %}"></script>

    {% block extra_js %}
    {% endblock %}
</body>
</html>